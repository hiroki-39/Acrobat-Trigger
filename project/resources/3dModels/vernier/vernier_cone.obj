# Vernier Jet Flame Cone Model
# Base at Z=0.0, Tip at Z=-2.2
mtllib vernier_cone.mtl
o VernierCone
usemtl VernierMaterial
v 0.0000 0.0000 0.0500
v 0.3000 0.0000 0.0000
v 0.2121 0.2121 0.0000
v 0.0000 0.3000 0.0000
v -0.2121 0.2121 0.0000
v -0.3000 0.0000 0.0000
v -0.2121 -0.2121 0.0000
v 0.0000 -0.3000 0.0000
v 0.2121 -0.2121 0.0000

v 0.0800 0.0000 -1.2000
v 0.0566 0.0566 -1.2000
v 0.0000 0.0800 -1.2000
v -0.0566 0.0566 -1.2000
v -0.0800 0.0000 -1.2000
v -0.0566 -0.0566 -1.2000
v 0.0000 -0.0800 -1.2000
v 0.0566 -0.0566 -1.2000

v 0.0000 0.0000 -2.2000

# Base cap (facing +Z into engine nozzle)
f 1 2 3
f 1 3 4
f 1 4 5
f 1 5 6
f 1 6 7
f 1 7 8
f 1 8 9
f 1 9 2

# Segment 1: Base to Mid
f 2 10 11
f 2 11 3
f 3 11 12
f 3 12 4
f 4 12 13
f 4 13 5
f 5 13 14
f 5 14 6
f 6 14 15
f 6 15 7
f 7 15 16
f 7 16 8
f 8 16 17
f 8 17 9
f 9 17 10
f 9 10 2

# Segment 2: Mid to Tip
f 10 18 11
f 11 18 12
f 12 18 13
f 13 18 14
f 14 18 15
f 15 18 16
f 16 18 17
f 17 18 10
